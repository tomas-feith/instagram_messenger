<?xml version="1.0" encoding="utf-8"?>
<!--
    The Android 11-and-below counterpart of data_extraction_rules.xml. allowBackup is off,
    so this only matters for device-to-device transfer: nothing is copied either way.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
